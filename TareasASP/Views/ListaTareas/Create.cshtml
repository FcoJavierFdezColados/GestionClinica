@model TareasASP.Models.ListaTareas

@{
    ViewData["Title"] = "Crear Lista de Tareas";
}

<h1>Crear Lista de Tareas</h1>

<h4>Introduce los datos de la Lista a crear:</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group mt-2">
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Crear</button>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-info mt-2"><i class="fa-solid fa-arrow-left"></i> Volver a las listas de tareas</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
