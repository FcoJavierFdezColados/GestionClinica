@model IEnumerable<TareasASP.Models.Tarea>

@{
    ViewData["Title"] = "Index";
}

<h1>Index @ViewData["NombreListaTareas"] </h1>

<p>
    <a asp-action="Create" asp-route-listaId="@ViewData["idListaTareas"]">Create New</a>
    <a asp-controller="ListaTareas" asp-action="Index">Volver a la lista de tareas</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreateDate)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.ListaTareas)
            </th> *@
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">
                        @Html.DisplayFor(modelItem => item.Name)
                    </a>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CreateDate)
                </td>
                @* <td>
                    @Html.DisplayFor(modelItem => item.ListaTareas.Name)
                </td> *@
                <td>
                    @{
                        string idModal = "borrarTarea" + item.Id;
                    }
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" data-bs-toggle="modal" data-bs-target="#@idModal">
                        Delete
                    </a>

                    <!-- Modal -->
                    <div class="modal fade" id="@idModal" tabindex="-1" aria-labelledby="BorrarModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="BorrarModalLabel">Borrar Tarea</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <p>¿Está seguro de querer borrar la tarea?</p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <form method="post" asp-action="DeleteConfirmed">
                                        <input name="id" type="text" asp-for="@item.Id" />

                                        <input type="submit" value="Delete" class="btn btn-danger" />
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
